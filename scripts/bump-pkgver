#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pkgbuild="${repo_root}/PKGBUILD"
base_version="${1:-0.1.0}"

cd "${repo_root}"
pkgver="${base_version}.r$(git rev-list --count HEAD).g$(git rev-parse --short=7 HEAD)"

sed -i "s/^pkgver=.*/pkgver=${pkgver}/" "${pkgbuild}"
printf 'Updated PKGBUILD to pkgver=%s\n' "${pkgver}"
